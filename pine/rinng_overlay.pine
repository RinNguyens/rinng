// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// rinng Overlay — draws on the price chart the concepts the rinng project computes in Python.
// Definitions follow src/rinng/analysis/{structure,smc,liquidity,volume_profile,wyckoff}.py:
//   Swing (length L): high[s] > every high of the L bars to the left and >= every high of the L bars to the right; known
//     at the close of bar s+L, used only from the next bar.
//   BOS/CHoCH: close (or wick) beyond the most recent known, unbroken swing; against the trend = CHoCH.
//   3-bar FVG: bull when low > high[2]; fully filled when low <= zone bottom (bull) / high >= zone top (bear).
//   Order block: last opposite-direction bar (within 50 bars) before the structure-breaking bar, requiring at least
//     one displacement (|body| > 1.5 × previous bar's ATR) between those two bars. Retouched = mitigated
//     (dashed border). Close through the far edge = invalidated, turns into a breaker (opposite color).
//   Liquidity: each swing is a BSL/SSL level, extended until a wick crosses it. Wick through then close
//     back inside on the same bar = sweep. Two same-type swings within <= 0.1 × ATR = EQH/EQL.
//   Premium/discount: the range between the most recent known swing high and swing low.
//   Weekly volume profile (UTC, Monday start): each bar's volume spread evenly across bins; POC, 70% value area,
//     naked POC. Only closed weeks are drawn.
//   Wyckoff climax: volume z-score (50 bars) >= 2.5 and range >= 1.8 × ATR.
// Pine limits: at most 500 lines, 500 boxes, 500 labels per script; the oldest zones are deleted first.
//@version=6
indicator("rinng Overlay", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_bars_back = 500)

grpS = "Structure"
L         = input.int(5, "Swing length", minval = 1, group = grpS)
breakOn   = input.string("close", "Break structure on", options = ["close", "wick"], group = grpS)
showSwing = input.bool(true, "HH/HL/LH/LL labels", group = grpS)
showBreak = input.bool(true, "BOS / CHoCH", group = grpS)
showPD    = input.bool(true, "Premium / discount", group = grpS)

grpZ = "Zones"
showFvg  = input.bool(true, "FVG", group = grpZ)
maxFvg   = input.int(30, "Max FVGs", minval = 1, maxval = 150, group = grpZ)
showOb   = input.bool(true, "Order block / breaker", group = grpZ)
maxOb    = input.int(20, "Max OBs", minval = 1, maxval = 100, group = grpZ)
dispK    = input.float(1.5, "Displacement: body > k × ATR", minval = 0.1, group = grpZ)

grpL = "Liquidity"
showLiq  = input.bool(true, "BSL / SSL levels", group = grpL)
maxLiq   = input.int(20, "Max levels per side", minval = 1, maxval = 100, group = grpL)
showEq   = input.bool(true, "EQH / EQL", group = grpL)
eqTol    = input.float(0.1, "EQH/EQL tolerance (× ATR)", minval = 0.0, group = grpL)
showSweep = input.bool(true, "Sweep", group = grpL)

grpV = "Weekly volume profile"
showVp   = input.bool(true, "Show", group = grpV)
nBins    = input.int(100, "Bins", minval = 10, maxval = 400, group = grpV)
vaPct    = input.float(0.70, "Value area", minval = 0.1, maxval = 0.99, group = grpV)
nWeeks   = input.int(6, "Weeks", minval = 1, maxval = 30, group = grpV)
showNaked = input.bool(true, "Naked POC", group = grpV)
showHist  = input.bool(true, "Histogram profile", group = grpV)
histRows  = input.int(24, "Histogram rows", minval = 8, maxval = 60, group = grpV)
showShape = input.bool(true, "D / P / b / DD shape labels", group = grpV)
ddValley  = input.float(0.30, "DD: valley between peaks <= this ratio × smaller peak", minval = 0.05, maxval = 0.9, group = grpV)

grpW = "Wyckoff"
showClimax = input.bool(true, "Climax (SC / BC)", group = grpW)

colBull = input.color(#26a69a, "Bullish color")
colBear = input.color(#ef5350, "Bearish color")
colPoc  = input.color(#ff9800, "POC color")

atr14 = ta.atr(14)

// ======================= Swing =======================
isPivot(bool wantHigh) =>
    bool ok = bar_index >= 2 * L
    if ok
        float p = wantHigh ? high[L] : low[L]
        for k = 1 to L
            float left  = wantHigh ? high[L + k] : low[L + k]
            float right = wantHigh ? high[L - k] : low[L - k]
            bool pass = wantHigh ? (p > left and p >= right) : (p < left and p <= right)
            if not pass
                ok := false
                break
    ok

pivHigh = isPivot(true)
pivLow  = isPivot(false)

// ======================= BOS / CHoCH (uses levels known before this bar) =======================
var float upLevel = na
var int   upIndex = na
var float dnLevel = na
var int   dnIndex = na
var int   trend   = 0

float upSrc = breakOn == "close" ? close : high
float dnSrc = breakOn == "close" ? close : low
int trendBefore = trend
bool brokeUp = not na(upLevel) and upSrc > upLevel
bool brokeDn = not na(dnLevel) and dnSrc < dnLevel

if brokeUp and showBreak
    bool ch = trendBefore == -1
    line.new(upIndex, upLevel, bar_index, upLevel, color = colBull, style = ch ? line.style_dashed : line.style_solid)
    label.new(int(math.round((upIndex + bar_index) / 2)), upLevel, ch ? "CHoCH" : "BOS", style = label.style_label_down, color = color.new(colBull, 100), textcolor = colBull, size = size.small)
if brokeDn and showBreak
    bool ch = trendBefore == 1
    line.new(dnIndex, dnLevel, bar_index, dnLevel, color = colBear, style = ch ? line.style_dashed : line.style_solid)
    label.new(int(math.round((dnIndex + bar_index) / 2)), dnLevel, ch ? "CHoCH" : "BOS", style = label.style_label_up, color = color.new(colBear, 100), textcolor = colBear, size = size.small)
if brokeUp
    upLevel := na
if brokeDn
    dnLevel := na
if brokeUp and not brokeDn
    trend := 1
else if brokeDn and not brokeUp
    trend := -1
else if brokeUp and brokeDn
    trend := close >= open ? 1 : -1

alertcondition(brokeUp and trendBefore == -1, "Bullish CHoCH", "rinng: bullish CHoCH {{ticker}} {{interval}}")
alertcondition(brokeDn and trendBefore == 1, "Bearish CHoCH", "rinng: bearish CHoCH {{ticker}} {{interval}}")

// ======================= Order block =======================
var array<box> obBoxes = array.new<box>()
var array<int> obSide  = array.new<int>()     // 1 = bullish OB, -1 = bearish OB
var array<int> obState = array.new<int>()     // 0 = OB, 1 = touched, 2 = breaker

bool dispUp = math.abs(close - open) > dispK * nz(atr14[1]) and close > open
bool dispDn = math.abs(close - open) > dispK * nz(atr14[1]) and close < open

findOb(int side) =>
    // Last opposite bar within the previous 50; needs a displacement in the break direction from after it until now.
    int found = -1
    bool sawDisp = side == 1 ? dispUp : dispDn
    for k = 1 to 50
        if bar_index - k < 0
            break
        bool opposite = side == 1 ? close[k] < open[k] : close[k] > open[k]
        if opposite
            found := k
            break
        bool d = side == 1 ? (math.abs(close[k] - open[k]) > dispK * nz(atr14[k + 1]) and close[k] > open[k]) : (math.abs(close[k] - open[k]) > dispK * nz(atr14[k + 1]) and close[k] < open[k])
        sawDisp := sawDisp or d
    [found, sawDisp]

// Called on every bar at global scope (Pine requires functions that use history to run on every bar).
[obUpK, obUpOk] = findOb(1)
[obDnK, obDnOk] = findOb(-1)

// Update tracked OBs (from the bar after the break).
if obBoxes.size() > 0
    for i = obBoxes.size() - 1 to 0
        box b = obBoxes.get(i)
        int s = obSide.get(i)
        int st = obState.get(i)
        float top = b.get_top()
        float bot = b.get_bottom()
        b.set_right(bar_index)
        if st < 2
            bool broken = s == 1 ? close < bot : close > top
            bool touched = s == 1 ? low <= top : high >= bot
            if broken
                obState.set(i, 2)
                b.set_bgcolor(color.new(s == 1 ? colBear : colBull, 88))
                b.set_border_color(color.new(s == 1 ? colBear : colBull, 40))
                b.set_text("breaker")
            else if touched and st == 0
                obState.set(i, 1)
                b.set_border_style(line.style_dashed)
        else
            bool dead = s == 1 ? close > top : close < bot
            if dead
                obBoxes.remove(i)
                obSide.remove(i)
                obState.remove(i)

if showOb and brokeUp and obUpK > 0 and obUpOk
    obBoxes.push(box.new(bar_index - obUpK, high[obUpK], bar_index, low[obUpK], border_color = color.new(colBull, 40), bgcolor = color.new(colBull, 85), text = "OB", text_size = size.tiny, text_color = colBull, text_halign = text.align_left))
    obSide.push(1)
    obState.push(0)
if showOb and brokeDn and obDnK > 0 and obDnOk
    obBoxes.push(box.new(bar_index - obDnK, high[obDnK], bar_index, low[obDnK], border_color = color.new(colBear, 40), bgcolor = color.new(colBear, 85), text = "OB", text_size = size.tiny, text_color = colBear, text_halign = text.align_left))
    obSide.push(-1)
    obState.push(0)
while obBoxes.size() > maxOb
    obBoxes.shift()
    obSide.shift()
    obState.shift()

// ======================= New swing → structure level, labels, liquidity =======================
var float lastSH = na
var float lastSL = na
var int   lastSHi = na
var int   lastSLi = na
var array<line>  liqLines = array.new<line>()
var array<int>   liqSide  = array.new<int>()   // 1 = BSL (above), -1 = SSL (below)

if pivHigh
    float p = high[L]
    if showSwing
        string tag = na(lastSH) ? "" : (p > lastSH ? "HH" : "LH")
        label.new(bar_index - L, p, tag, style = label.style_none, textcolor = colBull, size = size.tiny, yloc = yloc.abovebar)
    if showEq and not na(lastSH) and math.abs(p - lastSH) <= eqTol * atr14
        line.new(lastSHi, lastSH, bar_index - L, p, color = colBull, style = line.style_dotted)
        label.new(bar_index - L, p, "EQH", style = label.style_label_down, color = color.new(colBull, 100), textcolor = colBull, size = size.tiny)
    lastSH := p
    lastSHi := bar_index - L
    upLevel := p
    upIndex := bar_index - L
    if showLiq
        liqLines.push(line.new(bar_index - L, p, bar_index, p, color = color.new(colBull, 50), style = line.style_dotted, extend = extend.right))
        liqSide.push(1)
if pivLow
    float p = low[L]
    if showSwing
        string tag = na(lastSL) ? "" : (p >= lastSL ? "HL" : "LL")
        label.new(bar_index - L, p, tag, style = label.style_none, textcolor = colBear, size = size.tiny, yloc = yloc.belowbar)
    if showEq and not na(lastSL) and math.abs(p - lastSL) <= eqTol * atr14
        line.new(lastSLi, lastSL, bar_index - L, p, color = colBear, style = line.style_dotted)
        label.new(bar_index - L, p, "EQL", style = label.style_label_up, color = color.new(colBear, 100), textcolor = colBear, size = size.tiny)
    lastSL := p
    lastSLi := bar_index - L
    dnLevel := p
    dnIndex := bar_index - L
    if showLiq
        liqLines.push(line.new(bar_index - L, p, bar_index, p, color = color.new(colBear, 50), style = line.style_dotted, extend = extend.right))
        liqSide.push(-1)

// Liquidity level taken: stop the line; if price closes back inside, mark a sweep.
if liqLines.size() > 0
    for i = liqLines.size() - 1 to 0
        line ln = liqLines.get(i)
        int s = liqSide.get(i)
        float lv = ln.get_y1()
        if bar_index > ln.get_x1() + L
            bool taken = s == 1 ? high > lv : low < lv
            if taken
                ln.set_extend(extend.none)
                ln.set_x2(bar_index)
                bool swept = s == 1 ? close < lv : close > lv
                if showSweep and swept
                    label.new(bar_index, lv, "sweep", style = s == 1 ? label.style_label_down : label.style_label_up, color = color.new(s == 1 ? colBear : colBull, 100), textcolor = s == 1 ? colBear : colBull, size = size.tiny)
                liqLines.remove(i)
                liqSide.remove(i)
while liqLines.size() > 2 * maxLiq
    liqLines.shift().delete()
    liqSide.shift()

// ======================= FVG =======================
var array<box> fvgBoxes = array.new<box>()
var array<int> fvgSide  = array.new<int>()

if fvgBoxes.size() > 0
    for i = fvgBoxes.size() - 1 to 0
        box b = fvgBoxes.get(i)
        int s = fvgSide.get(i)
        b.set_right(bar_index)
        bool filled = s == 1 ? low <= b.get_bottom() : high >= b.get_top()
        if filled
            b.set_bgcolor(color.new(s == 1 ? colBull : colBear, 95))
            fvgBoxes.remove(i)
            fvgSide.remove(i)

if showFvg and bar_index >= 2
    if low > high[2]
        fvgBoxes.push(box.new(bar_index - 1, low, bar_index, high[2], border_color = na, bgcolor = color.new(colBull, 78), text = "FVG", text_size = size.tiny, text_color = color.new(colBull, 30), text_halign = text.align_right))
        fvgSide.push(1)
    if high < low[2]
        fvgBoxes.push(box.new(bar_index - 1, low[2], bar_index, high, border_color = na, bgcolor = color.new(colBear, 78), text = "FVG", text_size = size.tiny, text_color = color.new(colBear, 30), text_halign = text.align_right))
        fvgSide.push(-1)
while fvgBoxes.size() > maxFvg
    fvgBoxes.shift()
    fvgSide.shift()

// ======================= Premium / discount =======================
var box premBox = na
var box discBox = na
var line eqLine = na
if showPD and barstate.islast and not na(lastSH) and not na(lastSL) and lastSH > lastSL
    float mid = (lastSH + lastSL) / 2
    int x0 = math.min(lastSHi, lastSLi)
    box.delete(premBox)
    box.delete(discBox)
    line.delete(eqLine)
    premBox := box.new(x0, lastSH, bar_index + 10, mid, border_color = na, bgcolor = color.new(colBear, 93), text = "premium", text_size = size.tiny, text_color = color.new(colBear, 40), text_valign = text.align_top)
    discBox := box.new(x0, mid, bar_index + 10, lastSL, border_color = na, bgcolor = color.new(colBull, 93), text = "discount", text_size = size.tiny, text_color = color.new(colBull, 40), text_valign = text.align_bottom)
    eqLine := line.new(x0, mid, bar_index + 10, mid, color = color.gray, style = line.style_dashed)

// ======================= Weekly volume profile =======================
var array<float> wh = array.new<float>()
var array<float> wl = array.new<float>()
var array<float> wv = array.new<float>()
var int weekFirst = na
var array<line> pocLines = array.new<line>()
var array<box>  vaBoxes  = array.new<box>()
var array<line> nakedPoc = array.new<line>()
var array<box>   histBoxes   = array.new<box>()
var array<label> shapeLabels = array.new<label>()

classifyShape(array<float> prof, int poc) =>
    int n = prof.size()
    array<float> sm = array.new<float>(n, 0.0)
    for i = 0 to n - 1
        float acc = 0.0
        int cnt = 0
        for j = math.max(0, i - 2) to math.min(n - 1, i + 2)
            acc += prof.get(j)
            cnt += 1
        sm.set(i, acc / cnt)
    int p1 = sm.indexof(sm.max())
    int p2 = -1
    float best = 0.0
    for i = 1 to n - 2
        bool isPeak = sm.get(i) >= sm.get(i - 1) and sm.get(i) > sm.get(i + 1)
        if isPeak and math.abs(i - p1) >= n / 5 and sm.get(i) > best
            best := sm.get(i)
            p2 := i
    string shape = ""
    if p2 >= 0
        float valley = sm.get(p1)
        for i = math.min(p1, p2) to math.max(p1, p2)
            valley := math.min(valley, sm.get(i))
        if valley <= ddValley * math.min(sm.get(p1), sm.get(p2))
            shape := "DD"
    if shape == ""
        float frac = (poc + 0.5) / n
        shape := frac >= 0.65 ? "P" : frac <= 0.35 ? "b" : "D"
    shape

newWeek = ta.change(time("1W", "", "UTC")) != 0

closeWeek(int firstBar, int lastBar) =>
    float lo = wl.min()
    float hi = wh.max()
    if hi > lo
        float step = (hi - lo) / nBins
        array<float> prof = array.new<float>(nBins, 0.0)
        for k = 0 to wv.size() - 1
            int b0 = math.max(0, math.min(nBins - 1, int(math.floor((wl.get(k) - lo) / step))))
            int b1 = math.max(0, math.min(nBins - 1, int(math.floor((wh.get(k) - lo) / step))))
            float share = wv.get(k) / (b1 - b0 + 1)
            for j = b0 to b1
                prof.set(j, prof.get(j) + share)
        int poc = prof.indexof(prof.max())
        float total = prof.sum()
        float acc = prof.get(poc)
        int up = poc
        int dn = poc
        while acc < vaPct * total and (up < nBins - 1 or dn > 0)
            float upVol = (up + 1 < nBins ? prof.get(up + 1) : 0.0) + (up + 2 < nBins ? prof.get(up + 2) : 0.0)
            float dnVol = (dn - 1 >= 0 ? prof.get(dn - 1) : 0.0) + (dn - 2 >= 0 ? prof.get(dn - 2) : 0.0)
            if up < nBins - 1 and (upVol >= dnVol or dn == 0)
                for _ = 1 to math.min(2, nBins - 1 - up)
                    up += 1
                    acc += prof.get(up)
            else
                for _ = 1 to math.min(2, dn)
                    dn -= 1
                    acc += prof.get(dn)
        float pocPrice = lo + (poc + 0.5) * step
        pocLines.push(line.new(firstBar, pocPrice, lastBar, pocPrice, color = colPoc, width = 2))
        vaBoxes.push(box.new(firstBar, lo + (up + 1) * step, lastBar, lo + dn * step, border_color = na, bgcolor = color.new(colPoc, 92)))
        if showNaked
            nakedPoc.push(line.new(lastBar, pocPrice, lastBar + 1, pocPrice, color = colPoc, style = line.style_dotted, extend = extend.right))
        if showHist
            // Merge nBins bins into histRows rows; bar length proportional to volume, at most 70% of the week width.
            int per = math.max(1, int(math.ceil(nBins / histRows)))
            int rows = int(math.ceil(nBins / per))
            array<float> agg = array.new<float>(rows, 0.0)
            for j = 0 to nBins - 1
                int r = math.min(rows - 1, int(j / per))
                agg.set(r, agg.get(r) + prof.get(j))
            float mx = agg.max()
            int width = lastBar - firstBar
            for r = 0 to rows - 1
                int len = int(math.round(agg.get(r) / mx * width * 0.7))
                if len > 0
                    bool inPoc = poc >= r * per and poc < (r + 1) * per
                    bool inVa = (r + 1) * per - 1 >= dn and r * per <= up
                    color c = inPoc ? color.new(colPoc, 20) : inVa ? color.new(color.gray, 55) : color.new(color.gray, 80)
                    histBoxes.push(box.new(firstBar, lo + math.min(nBins, (r + 1) * per) * step, firstBar + len, lo + r * per * step, border_color = na, bgcolor = c))
        if showShape
            string shape = classifyShape(prof, poc)
            shapeLabels.push(label.new(firstBar, hi, shape, style = label.style_label_down, color = color.new(colPoc, 10), textcolor = color.black, size = size.normal))
        while pocLines.size() > nWeeks
            pocLines.shift().delete()
            vaBoxes.shift().delete()
            if shapeLabels.size() > nWeeks
                shapeLabels.shift().delete()
        while histBoxes.size() > nWeeks * histRows
            histBoxes.shift().delete()

if showVp
    if newWeek and not na(weekFirst) and wv.size() > 0
        closeWeek(weekFirst, bar_index - 1)
        wh.clear()
        wl.clear()
        wv.clear()
    if newWeek or na(weekFirst)
        weekFirst := bar_index
    if nakedPoc.size() > 0
        for i = nakedPoc.size() - 1 to 0
            line ln = nakedPoc.get(i)
            float p = ln.get_y1()
            if bar_index > ln.get_x1() and low <= p and high >= p
                ln.set_extend(extend.none)
                ln.set_x2(bar_index)
                nakedPoc.remove(i)
        while nakedPoc.size() > 20
            nakedPoc.shift().delete()
    wh.push(high)
    wl.push(low)
    wv.push(nz(volume))

// ======================= Wyckoff climax =======================
volZ = (volume - ta.sma(volume, 50)[1]) / ta.stdev(volume, 50)[1]
bigRange = (high - low) >= 1.8 * nz(atr14[1])
sc = showClimax and volZ >= 2.5 and bigRange and close < open
bc = showClimax and volZ >= 2.5 and bigRange and close > open
plotshape(sc, "Selling climax", shape.triangleup, location.belowbar, colBull, text = "SC", size = size.tiny)
plotshape(bc, "Buying climax", shape.triangledown, location.abovebar, colBear, text = "BC", size = size.tiny)
