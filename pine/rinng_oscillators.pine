// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// rinng Oscillators — separate pane: RSI, MACD histogram, volume delta and CVD.
// Delta here is an ESTIMATE from lower-timeframe bars (up-bar volume counts as buying, down-bar as selling),
// not the real taker buy volume used in Python (src/rinng/analysis/orderflow.py uses Binance's
// taker_buy_volume column). The two numbers will differ.
//@version=6
indicator("rinng Oscillators", overlay = false)

show   = input.string("CVD", "Show", options = ["RSI", "MACD", "Delta", "CVD"])
ltf    = input.timeframe("1", "Lower timeframe for delta estimate")
reset  = input.string("1W", "Reset CVD every", options = ["1D", "1W", "None"])

[ltfClose, ltfOpen, ltfVol] = request.security_lower_tf(syminfo.tickerid, ltf, [close, open, volume])
float delta = 0.0
// The array can be empty (bar has no lower-timeframe data yet); in Pine, for 0 to -1 runs backwards.
for i = 0 to math.max(ltfVol.size() - 1, -1)
    if ltfVol.size() == 0
        break
    float c = ltfClose.get(i)
    float o = ltfOpen.get(i)
    delta += c > o ? ltfVol.get(i) : c < o ? -ltfVol.get(i) : 0.0

// ta.change must run on every bar, so compute it at global scope, outside the conditional expression.
periodChanged = ta.change(time(reset == "None" ? "1W" : reset, "", "UTC")) != 0
var float cvd = 0.0
bool newPeriod = reset != "None" and periodChanged
cvd := (newPeriod ? 0.0 : cvd) + delta

rsi = ta.rsi(close, 14)
[macdLine, signalLine, hist] = ta.macd(close, 12, 26, 9)

plot(show == "RSI" ? rsi : na, "RSI", color.purple)
hline(70, "70", color.gray, hline.style_dotted, display = show == "RSI" ? display.all : display.none)
hline(30, "30", color.gray, hline.style_dotted, display = show == "RSI" ? display.all : display.none)
plot(show == "MACD" ? hist : na, "MACD hist", hist >= 0 ? color.teal : color.red, style = plot.style_columns)
plot(show == "Delta" ? delta : na, "Delta", delta >= 0 ? color.teal : color.red, style = plot.style_columns)
plot(show == "CVD" ? cvd : na, "CVD", color.orange)
