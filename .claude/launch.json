{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "rinng-live",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "rinng",
        "live",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "rinng-web",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "rinng",
        "web",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "rinng-ui-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "web",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "rinng-news-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "rinng",
        "web",
        "--port",
        "8011"
      ],
      "port": 8011
    },
    {
      "name": "rinng-news-ui",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "web",
        "exec",
        "vite",
        "dev",
        "--port",
        "3011"
      ],
      "port": 3011,
      "env": {
        "RINNG_API": "http://127.0.0.1:8011"
      }
    },
    {
      "name": "rinng-desk-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "rinng",
        "web",
        "--port",
        "8022"
      ],
      "port": 8022
    },
    {
      "name": "rinng-desk-ui",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "web",
        "exec",
        "vite",
        "dev",
        "--port",
        "3021"
      ],
      "port": 3021,
      "env": {
        "RINNG_API": "http://127.0.0.1:8022"
      }
    },
    {
      "name": "rinng-hub-ui",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "web",
        "exec",
        "vite",
        "dev",
        "--port",
        "3031"
      ],
      "port": 3031
    },
    {
      "name": "rinng-landing",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd web && exec ./node_modules/.bin/vite dev --port 3060 --strictPort"
      ],
      "port": 3060
    },
    {
      "name": "rinng-wallet",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd web && exec ./node_modules/.bin/vite dev --port 3070 --strictPort"
      ],
      "port": 3070
    },
    {
      "name": "rinng-slices-ui",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd web && exec ./node_modules/.bin/vite dev --port 3041 --strictPort"
      ],
      "port": 3041,
      "env": {
        "RINNG_API": "http://127.0.0.1:8001"
      }
    },
    {
      "name": "rinng-ui-8001",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "web",
        "dev"
      ],
      "port": 3000,
      "env": {
        "RINNG_API": "http://127.0.0.1:8001"
      }
    },
    {
      "name": "rinng-tt-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "rinng",
        "web",
        "--port",
        "8033"
      ],
      "port": 8033
    },
    {
      "name": "rinng-tt-ui",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd web && exec ./node_modules/.bin/vite dev --port 3033 --strictPort"
      ],
      "port": 3033,
      "env": {
        "RINNG_API": "http://127.0.0.1:8033"
      }
    }
  ]
}
