# systemd (Linux VPS). Edit User and WorkingDirectory, then:
#   sudo cp deploy/rinng-collector.service /etc/systemd/system/
#   sudo systemctl enable --now rinng-collector
# Before that, run `uv run rinng check` on the VPS to make sure the exchange does not block its IP.
[Unit]
Description=rinng realtime collector
After=network-online.target
Wants=network-online.target

[Service]
User=rinng
WorkingDirectory=/opt/rinng
ExecStart=/usr/local/bin/uv run rinng collect
Restart=always
RestartSec=30
KillSignal=SIGTERM
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
